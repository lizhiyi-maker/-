// pg-boss 的内部表（schema: pgboss）由 pg-boss 自己迁移，不纳入 Prisma。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── 账户 ─────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// 用户已发起账户删除：立即停用、不能登录，在线数据由删除流程（或 worker 的清扫任务）清理
  DELETING
}

model User {
  id          String     @id @default(cuid())
  /// HMAC(手机号)：用于唯一查找，不可逆
  phoneHash   String     @unique
  /// 应用层加密后的手机号（AES-256-GCM），仅用于展示脱敏与必要的联系
  phoneEnc    String
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  lastLoginAt DateTime?

  sessions      Session[]
  invite        InviteRedemption?
  people        Person[]
  preference    Preference?
  quotaEntries  QuotaEntry[]
  importBatches ImportBatch[]
  messages      Message[]
  screenshots   Screenshot[]
  consents      ConsentRecord[]
  analyses      Analysis[]
  events        OfflineEvent[]
  feedbacks     Feedback[]
  usages        ModelUsage[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  /// 令牌的 SHA-256；令牌本身只存在于用户的 httpOnly Cookie
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginCode {
  id         String    @id @default(cuid())
  phoneHash  String
  /// HMAC(手机号哈希 + 验证码)，不存明文验证码
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneHash, createdAt])
}

model RateLimitEvent {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  maxUses     Int
  usedCount   Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())

  redemptions InviteRedemption[]
}

model InviteRedemption {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String   @unique
  createdAt DateTime @default(now())

  invite InviteCode @relation(fields: [inviteId], references: [id])
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────── 对象档案 ─────────

enum Gender {
  MALE
  FEMALE
}

enum Stage {
  JUST_MET
  GETTING_TO_KNOW
  IN_RELATIONSHIP
  ENDED
}

enum PersonStatus {
  ACTIVE
  DELETING
}

enum Platform {
  WECHAT
  DOUYIN
  OTHER
}

enum Feeling {
  UNSURE
  WANT_TO_KNOW
  STRONG
  PAUSE
}

model Person {
  id               String       @id @default(cuid())
  userId           String
  nickname         String
  gender           Gender?
  channel          String?
  metAtApprox      String?
  /// 阶段由用户确认；未填写时为空
  stage            Stage?
  /// 见面经历与"是否暧昧"与阶段分开记录
  hasMet           Boolean?
  seesAsAmbiguous  Boolean?
  feelingsNote     String?
  expectationsNote String?
  status           PersonStatus @default(ACTIVE)
  /// 删除围栏：每次删除/失效都会递增，后台任务写回前校验
  generation       Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts    PlatformAccount[]
  feelings    FeelingEntry[]
  batches     ImportBatch[]
  messages    Message[]
  screenshots Screenshot[]
  analyses    Analysis[]
  events      OfflineEvent[]

  @@index([userId, status])
}

model PlatformAccount {
  id          String   @id @default(cuid())
  personId    String
  userId      String
  platform    Platform
  handle      String
  /// 由用户确认关联的时间；不允许凭昵称相同自动合并
  confirmedAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, platform, handle])
  @@index([userId])
}

/// "我的好感"：独立于系统评分，保留每次修改时间
model FeelingEntry {
  id        String   @id @default(cuid())
  personId  String
  userId    String
  value     Feeling
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

// ───────── 聊天资料导入 ─────────

enum SourceKind {
  TEXT
  SCREENSHOT
}

/// 用户对一批资料的标记：精选片段与不确定资料不能直接推断整段关系的主动频率与稳定性
enum DataKind {
  CONTINUOUS
  CURATED
  UNCERTAIN
}

enum BatchStatus {
  UPLOADING
  RECOGNIZING
  PENDING_CONFIRM
  CONFIRMED
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  SYSTEM
  OTHER
}

/// 未知时间与真实时间分开：只有 SECOND/MINUTE 才是可靠时间
enum TimePrecision {
  SECOND
  MINUTE
  DATE
  ORDER_ONLY
  UNKNOWN
}

enum Speaker {
  SELF
  OTHER
  UNKNOWN
}

enum RecognitionStatus {
  RECOGNIZED
  UNCERTAIN
  USER_EDITED
}

enum MessageState {
  STAGED
  CONFIRMED
}

model ImportBatch {
  id                  String      @id @default(cuid())
  userId              String
  personId            String
  platform            Platform
  sourceKind          SourceKind
  dataKind            DataKind
  status              BatchStatus @default(UPLOADING)
  parserId            String?
  /// 文本中的发言人名称 → SELF/OTHER，由用户确认
  labelRoles          Json        @default("{}")
  /// 用户明确确认"我/对方"的时间；未确认前不能保存，不能凭气泡颜色或默认值决定
  identityConfirmedAt DateTime?
  /// 删除围栏：删除时递增，后台任务写回前校验
  generation          Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  confirmedAt         DateTime?
  /// 识别轮次：每次"开始识别"/"重试失败项"加 1；额度预留以轮次为单位
  recRound            Int         @default(0)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  messages    Message[]
  screenshots Screenshot[]

  @@index([personId, status])
  @@index([userId, status])
}

model Message {
  id              String            @id @default(cuid())
  userId          String
  personId        String
  batchId         String
  /// 批次内的顺序
  seq             Int
  speaker         Speaker           @default(UNKNOWN)
  speakerLabel    String?
  type            MessageType       @default(TEXT)
  occurredAt      DateTime?
  timePrecision   TimePrecision     @default(UNKNOWN)
  /// 原始出处：{ kind: "text", line } 或（截图）{ kind: "image", index, ... }
  origin          Json
  recognition     RecognitionStatus @default(RECOGNIZED)
  uncertainReason String?
  state           MessageState      @default(STAGED)
  /// 与已保存消息重叠（仅暂存期间有意义，确认时默认合并）
  duplicateOfId   String?
  currentRevision Int               @default(1)
  createdAt       DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  batch       ImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  duplicateOf Message?          @relation("Overlap", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Message[]         @relation("Overlap")
  revisions   MessageRevision[]

  @@unique([batchId, seq])
  @@index([personId, state])
}

enum ScreenshotStatus {
  UPLOADED
  QUEUED
  RUNNING
  DONE
  FAILED
  /// 用户选择跳过识别失败的截图
  SKIPPED
}

/// 用户上传的聊天截图（原图）。确认保存后停止访问并清理文件，行保留（仅留哈希用于跨批次查重）。
model Screenshot {
  id          String           @id @default(cuid())
  userId      String
  personId    String
  batchId     String
  /// 批次内顺序（上传顺序）
  idx         Int
  sha256      String
  contentType String
  sizeBytes   Int
  storageKey  String           @unique
  status      ScreenshotStatus @default(UPLOADED)
  /// 所属识别轮次（ImportBatch.recRound）；未提交识别时为空
  round       Int?
  attempts    Int              @default(0)
  errorCode   String?
  /// 识别出的消息（整合进暂存消息前的中间结果，整合后清空）
  result      Json?
  createdAt   DateTime         @default(now())
  /// 提交识别的时间；用于发现卡住的任务
  queuedAt    DateTime?
  finishedAt  DateTime?
  /// 确认保存后置位：立即停止访问，由清理任务删除文件
  revokedAt   DateTime?
  purgedAt    DateTime?

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person      @relation(fields: [personId], references: [id], onDelete: Cascade)
  batch  ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, idx])
  @@index([personId, sha256])
  @@index([batchId, status])
}

/// 内容只存在于修订中；编辑产生新修订，证据引用 消息+修订（见 ADR-0002）
model MessageRevision {
  id        String   @id @default(cuid())
  messageId String
  revision  Int
  content   String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, revision])
}

// ───────── AI 服务同意与关系分析 ─────────

/// 用户对“向 AI 服务商发送内容”的同意。文案版本或服务商变化时需要重新同意。
model ConsentRecord {
  id         String   @id @default(cuid())
  userId     String
  version    Int
  providerId String
  acceptedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version, providerId])
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  /// 输入资料在分析期间被删除或修改：丢弃结果并退还额度
  INVALIDATED
}

/// 一次关系分析：输入资料快照 + 各类版本 + 校验后的结构化结果。结果保留，旧报告随时间推移显示为过期。
model Analysis {
  id                String         @id @default(cuid())
  userId            String
  personId          String
  status            AnalysisStatus @default(QUEUED)
  /// 提交时对象的代际；对象删除后迟到的任务不能写回
  generation        Int
  /// 提交（取快照）的时间，也是“资料截止时间”
  snapshotAt        DateTime
  messageCount      Int
  /// 输入资料快照：按顺序的 [{ id, revision, batchId, dataKind, seq, speaker, type, occurredAt, timePrecision }]。
  /// 内容不重复存放，按 (消息, 修订) 回查 MessageRevision 即可重建（修订只增不改，见 ADR-0002）。
  snapshotRefs      Json
  /// 输入的线下事件快照：[{ id, revision, kind, occurredOn }]。事实内容按 (事件, 修订) 回查 OfflineEventRevision；
  /// 个人感受不在其中，也从不发送给 AI 服务商。M3a 时期的旧分析为空数组。
  eventRefs         Json           @default("[]")
  eventCount        Int            @default(0)
  preferenceVersion Int
  preferenceValues  Json
  rulesVersion      String
  promptVersion     String
  modelId           String
  /// 校验与程序核验后的结果（引用已解析为 消息ID + 修订）
  output            Json?
  /// 流水线信息：分段数、各维度核验记录、警告
  meta              Json?
  /// 对方是否明确拒绝（来自核验后的结果，供快速筛选与排名准入）
  explicitRefusal   Boolean        @default(false)
  errorCode         String?
  queuedAt          DateTime
  startedAt         DateTime?
  finishedAt        DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, status, finishedAt])
  @@index([userId, status])
}

// ───────── 线下事件 ─────────

/// 线下事件的类型：见面、通话、取消安排、补充事实
enum EventKind {
  MEET
  CALL
  CANCELLED
  FACT_NOTE
}

/// 用户补充记录的线下事件。事实（类型、日期、经过）与个人感受分开保存：
/// 事实在每次修订里留存快照，可被报告引用；个人感受只留在本行，可随时修改，不是证据，也不发送给 AI 服务商。
model OfflineEvent {
  id              String    @id @default(cuid())
  userId          String
  personId        String
  /// 当前修订的类型与日期（冗余，便于排序与查询；与最新修订一致）
  kind            EventKind
  /// 事件发生的日期（UTC 零点表示的日期）
  occurredOn      DateTime  @db.Date
  /// 当前事实修订号；事实被修改时加 1，使引用旧修订的报告过期
  currentRevision Int       @default(1)
  /// 用户的个人感受：不是对方的客观事实，不版本化
  personalNote    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  person    Person                 @relation(fields: [personId], references: [id], onDelete: Cascade)
  revisions OfflineEventRevision[]

  @@index([personId, occurredOn])
}

/// 事实修订只增不改；证据引用 事件 + 修订（同 ADR-0002）
model OfflineEventRevision {
  id         String    @id @default(cuid())
  eventId    String
  revision   Int
  kind       EventKind
  occurredOn DateTime  @db.Date
  facts      String
  createdAt  DateTime  @default(now())

  event OfflineEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, revision])
}

// ───────── 偏好 ─────────

model Preference {
  id               String   @id @default(cuid())
  userId           String   @unique
  /// 每次保存递增；无记录表示使用公开默认配置（版本 0）
  version          Int      @default(1)
  expectation      String?
  contactFrequency String?
  pace             String?
  /// { 维度key: 1..5 }
  importance       Json
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────── 额度账本 ─────────

enum QuotaKind {
  SCREENSHOT
  ANALYSIS
}

enum QuotaEntryType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
}

model QuotaEntry {
  id        String         @id @default(cuid())
  userId    String
  kind      QuotaKind
  type      QuotaEntryType
  /// 对"可用额度"的影响：GRANT +n、RESERVE -n、RELEASE +n、SETTLE 0
  delta     Int
  /// 该条流水涉及的数量（SETTLE 记录实际使用量）
  amount    Int
  /// 任务幂等键；(user, kind, taskKey, type) 唯一，保证重试不重复扣减
  taskKey   String?
  periodKey String
  reason    String?
  actorId   String?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, taskKey, type])
  @@index([userId, kind, periodKey])
}

// ───────── 运营：模型用量与用户反馈 ─────────

enum UsageKind {
  ANALYSIS_EXTRACT
  ANALYSIS_INTERPRET
  RECOGNITION
}

/// 一次 AI 服务商调用的用量与估算成本。**不存任何聊天内容。** 账户删除后 userId 置空，只保留不含身份的成本记录。
model ModelUsage {
  id            String    @id @default(cuid())
  userId        String?
  kind          UsageKind
  /// 所属任务（分析 ID 或截图 ID），只用于按任务汇总
  taskId        String
  modelId       String
  /// 是否是模拟模型（模拟模型没有真实用量与成本）
  simulated     Boolean
  inputTokens   Int?
  outputTokens  Int?
  durationMs    Int
  success       Boolean
  /// 估算成本，单位：百万分之一元；null 表示无法估算（缺少用量或单价）
  costMicroYuan Int?
  createdAt     DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([taskId])
}

enum FeedbackCategory {
  BUG
  SUGGESTION
  INACCURATE
  OTHER
}

enum FeedbackStatus {
  NEW
  HANDLED
}

/// 用户反馈。`snippet` 只有用户主动粘贴才有，系统不会自动附带聊天或对象信息。随账户删除一并删除。
model Feedback {
  id        String           @id @default(cuid())
  userId    String
  category  FeedbackCategory
  message   String
  snippet   String?
  status    FeedbackStatus   @default(NEW)
  createdAt DateTime         @default(now())
  handledAt DateTime?
  handledBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}

// ───────── 审计 ─────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  /// 不得包含聊天正文、验证码、密钥
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
