// pg-boss 的内部表（schema: pgboss）由 pg-boss 自己迁移，不纳入 Prisma。
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────── 账户 ─────────

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id          String     @id @default(cuid())
  /// HMAC(手机号)：用于唯一查找，不可逆
  phoneHash   String     @unique
  /// 应用层加密后的手机号（AES-256-GCM），仅用于展示脱敏与必要的联系
  phoneEnc    String
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  lastLoginAt DateTime?

  sessions      Session[]
  invite        InviteRedemption?
  people        Person[]
  preference    Preference?
  quotaEntries  QuotaEntry[]
  importBatches ImportBatch[]
  messages      Message[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  /// 令牌的 SHA-256；令牌本身只存在于用户的 httpOnly Cookie
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model LoginCode {
  id         String    @id @default(cuid())
  phoneHash  String
  /// HMAC(手机号哈希 + 验证码)，不存明文验证码
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phoneHash, createdAt])
}

model RateLimitEvent {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model InviteCode {
  id          String    @id @default(cuid())
  code        String    @unique
  maxUses     Int
  usedCount   Int       @default(0)
  expiresAt   DateTime
  revokedAt   DateTime?
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())

  redemptions InviteRedemption[]
}

model InviteRedemption {
  id        String   @id @default(cuid())
  inviteId  String
  userId    String   @unique
  createdAt DateTime @default(now())

  invite InviteCode @relation(fields: [inviteId], references: [id])
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────── 对象档案 ─────────

enum Gender {
  MALE
  FEMALE
}

enum Stage {
  JUST_MET
  GETTING_TO_KNOW
  IN_RELATIONSHIP
  ENDED
}

enum PersonStatus {
  ACTIVE
  DELETING
}

enum Platform {
  WECHAT
  DOUYIN
  OTHER
}

enum Feeling {
  UNSURE
  WANT_TO_KNOW
  STRONG
  PAUSE
}

model Person {
  id               String       @id @default(cuid())
  userId           String
  nickname         String
  gender           Gender?
  channel          String?
  metAtApprox      String?
  /// 阶段由用户确认；未填写时为空
  stage            Stage?
  /// 见面经历与"是否暧昧"与阶段分开记录
  hasMet           Boolean?
  seesAsAmbiguous  Boolean?
  feelingsNote     String?
  expectationsNote String?
  status           PersonStatus @default(ACTIVE)
  /// 删除围栏：每次删除/失效都会递增，后台任务写回前校验
  generation       Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts PlatformAccount[]
  feelings FeelingEntry[]
  batches  ImportBatch[]
  messages Message[]

  @@index([userId, status])
}

model PlatformAccount {
  id          String   @id @default(cuid())
  personId    String
  userId      String
  platform    Platform
  handle      String
  /// 由用户确认关联的时间；不允许凭昵称相同自动合并
  confirmedAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, platform, handle])
  @@index([userId])
}

/// "我的好感"：独立于系统评分，保留每次修改时间
model FeelingEntry {
  id        String   @id @default(cuid())
  personId  String
  userId    String
  value     Feeling
  createdAt DateTime @default(now())

  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
}

// ───────── 聊天资料导入 ─────────

enum SourceKind {
  TEXT
  SCREENSHOT
}

/// 用户对一批资料的标记：精选片段与不确定资料不能直接推断整段关系的主动频率与稳定性
enum DataKind {
  CONTINUOUS
  CURATED
  UNCERTAIN
}

enum BatchStatus {
  UPLOADING
  RECOGNIZING
  PENDING_CONFIRM
  CONFIRMED
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  SYSTEM
  OTHER
}

/// 未知时间与真实时间分开：只有 SECOND/MINUTE 才是可靠时间
enum TimePrecision {
  SECOND
  MINUTE
  DATE
  ORDER_ONLY
  UNKNOWN
}

enum Speaker {
  SELF
  OTHER
  UNKNOWN
}

enum RecognitionStatus {
  RECOGNIZED
  UNCERTAIN
  USER_EDITED
}

enum MessageState {
  STAGED
  CONFIRMED
}

model ImportBatch {
  id                  String      @id @default(cuid())
  userId              String
  personId            String
  platform            Platform
  sourceKind          SourceKind
  dataKind            DataKind
  status              BatchStatus @default(UPLOADING)
  parserId            String?
  /// 文本中的发言人名称 → SELF/OTHER，由用户确认
  labelRoles          Json        @default("{}")
  /// 用户明确确认"我/对方"的时间；未确认前不能保存，不能凭气泡颜色或默认值决定
  identityConfirmedAt DateTime?
  /// 删除围栏：删除时递增，后台任务写回前校验
  generation          Int         @default(0)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  confirmedAt         DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  person   Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([personId, status])
  @@index([userId, status])
}

model Message {
  id              String            @id @default(cuid())
  userId          String
  personId        String
  batchId         String
  /// 批次内的顺序
  seq             Int
  speaker         Speaker           @default(UNKNOWN)
  speakerLabel    String?
  type            MessageType       @default(TEXT)
  occurredAt      DateTime?
  timePrecision   TimePrecision     @default(UNKNOWN)
  /// 原始出处：{ kind: "text", line } 或（截图）{ kind: "image", index, ... }
  origin          Json
  recognition     RecognitionStatus @default(RECOGNIZED)
  uncertainReason String?
  state           MessageState      @default(STAGED)
  /// 与已保存消息重叠（仅暂存期间有意义，确认时默认合并）
  duplicateOfId   String?
  currentRevision Int               @default(1)
  createdAt       DateTime          @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  person      Person            @relation(fields: [personId], references: [id], onDelete: Cascade)
  batch       ImportBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  duplicateOf Message?          @relation("Overlap", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates  Message[]         @relation("Overlap")
  revisions   MessageRevision[]

  @@unique([batchId, seq])
  @@index([personId, state])
}

/// 内容只存在于修订中；编辑产生新修订，证据引用 消息+修订（见 ADR-0002）
model MessageRevision {
  id        String   @id @default(cuid())
  messageId String
  revision  Int
  content   String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, revision])
}

// ───────── 偏好 ─────────

model Preference {
  id               String   @id @default(cuid())
  userId           String   @unique
  /// 每次保存递增；无记录表示使用公开默认配置（版本 0）
  version          Int      @default(1)
  expectation      String?
  contactFrequency String?
  pace             String?
  /// { 维度key: 1..5 }
  importance       Json
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────── 额度账本 ─────────

enum QuotaKind {
  SCREENSHOT
  ANALYSIS
}

enum QuotaEntryType {
  GRANT
  RESERVE
  SETTLE
  RELEASE
}

model QuotaEntry {
  id        String         @id @default(cuid())
  userId    String
  kind      QuotaKind
  type      QuotaEntryType
  /// 对"可用额度"的影响：GRANT +n、RESERVE -n、RELEASE +n、SETTLE 0
  delta     Int
  /// 该条流水涉及的数量（SETTLE 记录实际使用量）
  amount    Int
  /// 任务幂等键；(user, kind, taskKey, type) 唯一，保证重试不重复扣减
  taskKey   String?
  periodKey String
  reason    String?
  actorId   String?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, taskKey, type])
  @@index([userId, kind, periodKey])
}

// ───────── 审计 ─────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  /// 不得包含聊天正文、验证码、密钥
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
