# 运行模式：demo（本地演示，允许模拟服务与开发登录）或 production（生产，禁止任何模拟/绕过）
# NODE_ENV=production 时若 APP_MODE=demo，应用与 worker 将拒绝启动。
APP_MODE=demo

# 数据库（本地由 `npm run db:dev` 启动 embedded-postgres）
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/relationship

# 服务提供方：本地用 mock/local；生产必须是真实提供方
AI_PROVIDER=mock          # mock | bailian
STORAGE_PROVIDER=local    # local | oss
SMS_PROVIDER=mock         # mock | aliyun
DEV_LOGIN_ENABLED=true    # 仅 demo 模式有效

# 可信反向代理层数（用于 IP 限流）。0=不信任 X-Forwarded-For，所有请求共用一个 IP 限流桶；
# 生产环境必须部署在会向 X-Forwarded-For 右侧追加真实客户端 IP 的代理/负载均衡之后，并填写层数（如 1）。
TRUSTED_PROXY_HOPS=0

# 密钥（生产必须设置且不得为示例值；用 `openssl rand -hex 32` 生成）
AUTH_SECRET=dev-only-auth-secret-change-me-0000000000
PHONE_HMAC_KEY=dev-only-phone-hmac-key-change-me-00000
PHONE_ENC_KEY=dev-only-phone-enc-key-change-me-0000000

# 真实服务凭据（仅生产/联调时填写，切勿提交）
# DASHSCOPE_API_KEY=
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_REGION=
# SMS_SIGN_NAME=
# SMS_TEMPLATE_CODE=
